DATABASE_URL=postgres://user:password@localhost:5432/optiondemodb

# --- OPT / economy ---
INITIAL_OPT_BALANCE=10000
# One exchange rate governs OPT<->virtual dollars everywhere: 1 virtual $ == 5 OPT.
# These three MUST stay equal, or burning Portfolio for OPT becomes a risk-free money pump
# (buy deep in-the-money, exercise, repeat) that breaks the leaderboard.
PORTFOLIO_TO_OPT_RATIO=5
EXERCISE_OPT_PER_DOLLAR=5
PREMIUM_OPT_PER_DOLLAR=5
# market: exercising credits settle_price * amount (real call payoff, the default).
# strike: credits strike * amount (the literal IDEA.md section 4 reading).
EXERCISE_PAYOUT_MODE=market

# --- Energy ---
INITIAL_ENERGY_CAPACITY=10
ENERGY_REFILL_SECONDS=300
OPTION_ENERGY_COST=1
PVP_ENERGY_COST=5

# --- XP ---
SUCCESSFUL_OPTION_XP=100
PVP_WIN_XP=500

# --- PvP ---
# = $2000 of arena purchasing power at 5 OPT/$. Must comfortably exceed the exercise
# cost of a typical position (5 x notional) or players can't complete the loop in-match.
PVP_INITIAL_OPT=10000
PVP_WIN_OPT_REWARD=300
PVP_WIN_PORTFOLIO_REWARD=250

# --- Store ---
ENERGY_CELL_PRICES=500,900,1500,2400
ENERGY_CELL_STEP=2
ENERGY_CHARGE_PRICE=200
