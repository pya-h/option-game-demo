# ============================================================================
# Only DATABASE_URL is required. Every other value below has a default in
# lib/config.ts, and those defaults ARE the tuned game — an empty .env gives a
# fully playable install. Uncomment a line only to override it.
# ============================================================================

DATABASE_URL=postgres://user:password@localhost:5432/optiondemodb

# --- OPT / economy -----------------------------------------------------------
# INITIAL_OPT_BALANCE=50000

# One exchange rate governs OPT <-> virtual dollars everywhere: $1 == 5 OPT.
# These three MUST stay equal. If converting Portfolio to OPT is cheaper than
# converting it back through an option, buying deep in-the-money and exercising
# becomes a risk-free money pump that breaks the leaderboard.
# PORTFOLIO_TO_OPT_RATIO=5
# EXERCISE_OPT_PER_DOLLAR=5
# PREMIUM_OPT_PER_DOLLAR=5
# EXERCISE_PAYOUT_MODE=market     # market | strike

# --- Energy ------------------------------------------------------------------
# The starting ceiling. Levels add +1 each on top, and store upgrades add a step
# each; total capacity is always derived, never stored.
# INITIAL_ENERGY_CAPACITY=50
# ENERGY_REFILL_SECONDS=300
# OPTION_ENERGY_COST=1
# PVP_ENERGY_COST=10

# --- XP and levels -----------------------------------------------------------
# SUCCESSFUL_OPTION_XP=100
# EXERCISE_XP=40                  # paid on top, so a lapsed window costs XP too
# PVP_WIN_XP=500
# The level curve (XP_LEVEL_BASE / XP_LEVEL_FACTOR) is a plain constant rather
# than an env var: it runs on the client too, and a client bundle can't read the
# server env — env-driven values there would quote two different numbers.

# --- The OPT drip ------------------------------------------------------------
# A trickle so a player with no OPT and no Portfolio still has a way back in.
# Lands every ENERGY_REFILL_SECONDS x 2, and only while the player has actually
# been playing — uncapped income for an idle account would pay more for walking
# away than for playing.
# OPT_DRIP_AMOUNT=250
# OPT_DRIP_IDLE_DAYS=7
# OPT_DRIP_UPGRADE_PRICES=900,2000,4200   # one-time; repeatable would compound
# OPT_DRIP_UPGRADE_STEP=50

# --- Claiming a win ----------------------------------------------------------
# How long a WON card stays claimable is scaled to how long it ran (the table
# lives in lib/config.ts); this is the ceiling on that.
# MAX_EXERCISE_WINDOW_SECONDS=21600       # 6 hours

# --- PvP ---------------------------------------------------------------------
# Must comfortably exceed the exercise cost of a typical in-match position
# (5 x notional), or players can't complete the loop before the whistle.
# PVP_INITIAL_OPT=20000
# PVP_WIN_OPT_REWARD=300
# PVP_WIN_PORTFOLIO_REWARD=250

# --- Store -------------------------------------------------------------------
# Energy Cell = capacity + a full charge. Capacity Chip = the ceiling only.
# Charge = the bar only. The Cell must stay below CHIP + CHARGE at every tier,
# or the bundle is just the expensive option and nobody would take it.
# ENERGY_CELL_PRICES=700,1100,1700,2500
# ENERGY_CAPACITY_PRICES=400,800,1400,2200
# ENERGY_CELL_STEP=10
# ENERGY_CHARGE_PRICE=400
